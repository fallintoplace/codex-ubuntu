#!/usr/bin/env bash
set -euo pipefail
umask 077

DISPLAY_NAME="Codex Desktop"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/codex-ubuntu"
CONFIG_FILE="${CONFIG_DIR}/electron.env"
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/codex-ubuntu"
LOG_FILE="${LOG_DIR}/electron-wrapper.log"
DISABLE_NOTIFICATIONS="${CODEX_UBUNTU_DISABLE_NOTIFICATIONS:-0}"

mkdir -p "$LOG_DIR"
chmod 700 "$LOG_DIR" >/dev/null 2>&1 || true
mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_DIR" >/dev/null 2>&1 || true

log() {
  printf '[%s] %s\n' "$(date -Is)" "$*" >>"$LOG_FILE"
}

notify_failure() {
  local message="$1"
  case "$DISABLE_NOTIFICATIONS" in
    1 | true | TRUE | yes | YES)
      return 0
      ;;
  esac
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "$DISPLAY_NAME" "$message" || true
  fi
}

load_config_file() {
  local config_output=""
  local line=""
  local key=""
  local value=""

  [ -f "$CONFIG_FILE" ] || return 0

  chmod 600 "$CONFIG_FILE" >/dev/null 2>&1 || true

  if ! config_output="$(
    python3 - "$CONFIG_FILE" <<'PY'
from pathlib import Path
import shlex
import sys

config_path = Path(sys.argv[1])
allowed_keys = {
    "CODEX_UBUNTU_ELECTRON_APP_ROOT",
    "CODEX_UBUNTU_NODE_BIN_DIR",
}

for line_number, raw_line in enumerate(
    config_path.read_text(encoding="utf-8").splitlines(),
    start=1,
):
    stripped = raw_line.strip()
    if not stripped or stripped.startswith("#"):
        continue
    if "=" not in raw_line:
        print(
            f"Invalid config line in {config_path}:{line_number}",
            file=sys.stderr,
        )
        raise SystemExit(1)

    key, raw_value = raw_line.split("=", 1)
    key = key.strip()
    if key not in allowed_keys:
        print(
            f"Unsupported key in {config_path}:{line_number}: {key}",
            file=sys.stderr,
        )
        raise SystemExit(1)

    raw_value = raw_value.strip()
    if not raw_value:
        value = ""
    else:
        try:
            tokens = shlex.split(raw_value, posix=True)
        except ValueError as exc:
            print(
                f"Invalid shell-like value for {key} in {config_path}:{line_number}: {exc}",
                file=sys.stderr,
            )
            raise SystemExit(1)

        if len(tokens) != 1:
            print(
                f"Invalid shell-like value for {key} in {config_path}:{line_number}",
                file=sys.stderr,
            )
            raise SystemExit(1)

        value = tokens[0]

    print(f"{key}={value}")
PY
  )"; then
    return 1
  fi

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      CODEX_UBUNTU_ELECTRON_APP_ROOT)
        CODEX_UBUNTU_ELECTRON_APP_ROOT="$value"
        ;;
      CODEX_UBUNTU_NODE_BIN_DIR)
        CODEX_UBUNTU_NODE_BIN_DIR="$value"
        ;;
    esac
  done <<<"$config_output"
}

prepend_path_once() {
  local dir="$1"
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) PATH="$dir:$PATH" ;;
  esac
}

resolve_node_bin_dir() {
  if [ -n "${CODEX_UBUNTU_NODE_BIN_DIR:-}" ]; then
    if [ ! -x "${CODEX_UBUNTU_NODE_BIN_DIR}/node" ]; then
      printf 'Configured CODEX_UBUNTU_NODE_BIN_DIR is invalid: %s\n' "${CODEX_UBUNTU_NODE_BIN_DIR}" >&2
      exit 1
    fi
    printf '%s\n' "${CODEX_UBUNTU_NODE_BIN_DIR}"
    return 0
  fi

  if command -v node >/dev/null 2>&1; then
    return 1
  fi

  local latest_nvm_bin=""
  latest_nvm_bin="$(find "${HOME}/.nvm/versions/node" -mindepth 2 -maxdepth 2 -type d -name bin 2>/dev/null | sort -V | tail -n 1 || true)"
  if [ -n "$latest_nvm_bin" ] && [ -x "${latest_nvm_bin}/node" ]; then
    printf '%s\n' "$latest_nvm_bin"
    return 0
  fi

  return 1
}

resolve_app_root() {
  local candidate=""
  local bootstrap_hint="codex-desktop-bootstrap"

  if [ -n "${CODEX_UBUNTU_ELECTRON_APP_ROOT:-}" ]; then
    candidate="${CODEX_UBUNTU_ELECTRON_APP_ROOT}"
    if [ ! -x "${candidate}/start.sh" ]; then
      printf 'Configured CODEX_UBUNTU_ELECTRON_APP_ROOT is invalid: %s\n' "$candidate" >&2
      exit 1
    fi
    printf '%s\n' "$candidate"
    return 0
  fi

  for candidate in \
    "${HOME}/.local/opt/codex-ubuntu/current/codex-app" \
    "${HOME}/.local/opt/codex-ubuntu/codex-app" \
    "${HOME}/codex-desktop-linux/codex-app" \
    "${HOME}/.local/opt/codex-desktop-linux/codex-app" \
    "${HOME}/.local/opt/codex-desktop-linux/current/codex-app"; do
    if [ -x "${candidate}/start.sh" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  printf 'Could not find a usable Codex Desktop app root.\n' >&2
  if command -v "$bootstrap_hint" >/dev/null 2>&1; then
    notify_failure "Run ${bootstrap_hint} once to build the local desktop payload."
    printf 'Run %s to build and install the local desktop payload.\n' "$bootstrap_hint" >&2
  fi
  printf 'Set CODEX_UBUNTU_ELECTRON_APP_ROOT to a directory containing start.sh.\n' >&2
  exit 1
}

main() {
  local node_bin_dir=""
  local app_root=""

  load_config_file
  prepend_path_once "${HOME}/.local/bin"
  if node_bin_dir="$(resolve_node_bin_dir)"; then
    prepend_path_once "$node_bin_dir"
    export CODEX_UBUNTU_NODE_BIN_DIR="$node_bin_dir"
  fi
  export PATH

  app_root="$(resolve_app_root)"
  export CODEX_UBUNTU_ELECTRON_APP_ROOT="$app_root"

  log "Launching ${DISPLAY_NAME} from ${app_root}"
  nohup "${app_root}/start.sh" "$@" >>"$LOG_FILE" 2>&1 &
}

main "$@"
