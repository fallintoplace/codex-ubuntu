#!/usr/bin/env bash
set -euo pipefail

if [ -n "${CODEX_UBUNTU_TEST_XDOTOOL_LOG:-}" ]; then
  printf '%s\n' "$*" >>"$CODEX_UBUNTU_TEST_XDOTOOL_LOG"
fi

case "${1:-}" in
  search)
    if [ -n "${CODEX_UBUNTU_TEST_XDOTOOL_WINDOW_ID:-}" ]; then
      printf '%s\n' "$CODEX_UBUNTU_TEST_XDOTOOL_WINDOW_ID"
      exit 0
    fi
    exit 1
    ;;
  windowactivate)
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
